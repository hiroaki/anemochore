{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anemochore-development",
  "main": "src/index.js",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "GPX_STORE",
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DELETE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "ANEMOCHORE_API_KEYS"
    ]
  },
  "env": {
    "staging": {
      "name": "anemochore-staging",
      "workers_dev": true,
      "kv_namespaces": [
        {
          "binding": "GPX_STORE",
          "id": "<STAGING_KV_NAMESPACE_ID>"
        }
      ],
      "ratelimits": [
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "DELETE_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": [
          "ANEMOCHORE_API_KEYS"
        ]
      }
    },
    "production": {
      "name": "anemochore",
      "kv_namespaces": [
        {
          "binding": "GPX_STORE",
          "id": "<PRODUCTION_KV_NAMESPACE_ID>"
        }
      ],
      "ratelimits": [
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "DELETE_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": [
          "ANEMOCHORE_API_KEYS"
        ]
      }
    }
  }
}
